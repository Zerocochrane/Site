# Port the API (and the built website) runs on
PORT=4000

# Password the photographer uses to log into /admin  — CHANGE THIS
ADMIN_PASSWORD=change-me
# Any long random string, used to sign login tokens — CHANGE THIS
TOKEN_SECRET=replace-with-a-long-random-string

# Where booking requests are sent
PHOTOGRAPHER_EMAIL=photographer@example.com

# SMTP settings for sending email (e.g. Gmail: smtp.gmail.com, port 465, an App Password)
# If SMTP_HOST is empty, requests are still saved and shown in the admin panel,
# and the email is printed to the server console instead of being sent.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Portfolio <no-reply@example.com>"

# Public address of the website, used for the links in client emails
# (development: http://localhost:5173 — production: your domain, e.g. https://anafotografia.com.br)
SITE_URL=http://localhost:5173
